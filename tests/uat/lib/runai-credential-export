#
# Reads the Run:ai harness credential JSON on stdin and publishes it, masked,
# to the following workflow steps through GITHUB_ENV (runai_credential_export in
# runai-harness.sh). An executable rather than a `source` in the workflow step:
# tests/uat/workflow_security_test.go audits credential-bearing steps and fails
# closed on a `source`, whose content it cannot see.
#
#   gcloud secrets versions access latest --secret aicr-uat-runai-harness \
#     | ./tests/uat/lib/runai-credential-export
set -euo pipefail
# shellcheck source=./runai-harness.sh
source "$(dirname "${BASH_SOURCE[0]}")/runai-harness.sh"
runai_credential_export
